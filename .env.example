# Copy to .env and fill in your vault credentials.
# .env is gitignored — never commit real credentials.

# Base URL of your M-Files vault, without /REST or any endpoint path.
MFILES_URL=https://your-vault.example.com

# Vault GUID. Braces are optional — the client normalizes the format.
MFILES_VAULT_GUID=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX

MFILES_USERNAME=your-user@example.com
MFILES_PASSWORD=your-password
