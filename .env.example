# Copy to .env and fill in your vault credentials.
# .env is gitignored — never commit real credentials.

# Base URL of your M-Files vault, without /REST or any endpoint path.
MFILES_URL=https://your-vault.example.com

# Vault GUID. Braces are optional — the client normalizes the format.
MFILES_VAULT_GUID=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX

MFILES_USERNAME=your-user@example.com
MFILES_PASSWORD=your-password

# Optional: register the write tools (object metadata + structure changes).
# Leave unset for a read-only explorer.
# MFILES_ALLOW_WRITES=true

# Optional, structure tools only (see vault-app/README.md).
# When to send MFILES_USERNAME/MFILES_PASSWORD to the vault app for its admin
# session: auto (default: only if its Windows login fails), credentials, windows.
# MFILES_STRUCTURE_LOGIN=auto
# MFILES_DOMAIN=CONTOSO
# How long a structure tool waits for its job before returning a job_id.
# MFILES_STRUCTURE_WAIT_SECONDS=45
# The M-Files server's RPC endpoint as seen from the server itself.
# MFILES_STRUCTURE_SERVER_ENDPOINT=ncacn_ip_tcp:localhost:2266
