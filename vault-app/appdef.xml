<?xml version="1.0" encoding="utf-8" ?>
<application
      type="server-application"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="http://www.m-files.com/schemas/appdef-server-v3.xsd">
  <guid>a87388a0-5c06-4fca-a858-8209f27bfdad</guid>
  <name>MFilesMCP Structure</name>
  <description>Vault extension methods that let the mcp-mfiles MCP server read and change metadata structure: property definitions (including calculated values and validation scripts), classes, value lists, workflows (states, transitions, scripts) and VBScript event handlers. Every method requires the Change metadata structure vault right.</description>
  <publisher>Cristian Rusu</publisher>
  <version>1.0.10</version>
  <copyright>MIT License</copyright>
  <required-mfiles-version>23.6.0.0</required-mfiles-version>
  <multi-server-compatible>true</multi-server-compatible>
  <extension-objects>
    <extension-object>
      <name>MFilesMCP.VaultApp</name>
      <assembly>MFilesMCP.VaultApp.dll</assembly>
      <class>MFilesMCP.VaultApp.VaultApplication</class>
      <installation-method>Install</installation-method>
      <uninstallation-method>Uninstall</uninstallation-method>
      <initialization-method>Initialize</initialization-method>
      <uninitialization-method>Uninitialize</uninitialization-method>
      <start-operations-method>StartOperations</start-operations-method>
    </extension-object>
  </extension-objects>
</application>
