<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>MFilesMCP.VaultApp</AssemblyName>
    <RootNamespace>MFilesMCP.VaultApp</RootNamespace>
    <Version>1.0.10</Version>
    <LangVersion>7.3</LangVersion>
    <!-- A vault app is installed as a folder of DLLs, so NuGet dependencies must land in bin. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!--
    Don't embed the Interop.MFilesAPI types (no EmbedInteropTypes anywhere):
    embedding gives them a different identity than in MFiles.VAF.dll, which
    M-Files' own interop package warns "causes errors". Version 1.0.0 embedded
    them and never finished starting on an M-Files 25 server.
  -->
  <ItemGroup>
    <PackageReference Include="MFiles.VAF" Version="24.10.720.2" />
    <!-- Lets the project build without the .NET Framework targeting pack (e.g. on macOS/Linux CI). -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appdef.xml" CopyToOutputDirectory="Always" />
  </ItemGroup>

  <!-- An .mfappx is a zip of the output folder with appdef.xml at its root. -->
  <Target Name="PackageMfappx" AfterTargets="Build">
    <PropertyGroup>
      <MfappxPath>$(MSBuildProjectDirectory)/bin/$(Configuration)/$(AssemblyName).mfappx</MfappxPath>
    </PropertyGroup>
    <Delete Files="$(MfappxPath)" />
    <ZipDirectory SourceDirectory="$(TargetDir)" DestinationFile="$(MfappxPath)" Overwrite="true" />
    <Message Importance="high" Text="Vault application package: $(MfappxPath)" />
  </Target>

</Project>
